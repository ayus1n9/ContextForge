# ============================================================
# ContextForge Environment Configuration
# ============================================================

# Environment
APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8000

# LLM Provider Configuration
# Supported: "mock", "bedrock"
LLM_PROVIDER=mock
MOCK_PROVIDER_RESPONSE_LATENCY_MS=50

# Optional Amazon Bedrock Configuration (Only used when LLM_PROVIDER=bedrock)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=DRAFT

# Ingestion & Document Safety
MAX_UPLOAD_SIZE_BYTES=10485760 # 10 MB
MAX_PDF_PAGES=50
INGESTION_TIMEOUT_SECONDS=30
ALLOWED_MIME_TYPES=["application/pdf"]

# Retrieval Configuration
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE_THRESHOLD=0.35
EMBEDDING_PROVIDER=mock # "mock" or "bedrock"

# Security & Guardrails Policies
# PII Policy: "BLOCK", "REDACT", "ALLOW"
INPUT_PII_POLICY=REDACT
RETRIEVAL_PII_POLICY=REDACT
OUTPUT_PII_POLICY=REDACT

# Direct Prompt Injection Policy: "BLOCK", "DETECT_ONLY"
PROMPT_INJECTION_POLICY=BLOCK

# Output Safety
ENFORCE_GROUNDING_CHECK=true
ENFORCE_OUTPUT_SANITIZATION=true
ENFORCE_SAFETY_DISCLAIMERS=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Audit Logging
AUDIT_LOG_FILE=contextforge_security_events.log
LOG_LEVEL=INFO
